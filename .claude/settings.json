{
  "permissions": {
    "deny": ["Bash(sudo *)", "Bash(curl * | bash)", "Bash(wget * | bash)", "Read(./.env)", "Read(./.env.*)"],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-bash.mjs"
          }
        ]
      }
    ]
  }
}
